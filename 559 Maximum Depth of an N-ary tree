/**
 * Definition for a Node.
 * struct Node {
 *     int val;
 *     int numChildren;
 *     struct Node** children;
 * };
 */

int maxDepth(struct Node* root) {
    if (root == NULL)
        return 0;

    if (root->numChildren == 0)
        return 1;

    int maxdepth = 0;

    for (int i = 0; i < root->numChildren; i++) {
        int depth = maxDepth(root->children[i]);
        if (depth > maxdepth)
            maxdepth = depth;
    }

    return 1 + maxdepth;
}
